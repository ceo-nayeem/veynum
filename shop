.qv .art i.l{left:calc(50% - 82px)}.qv .art i.r{left:calc(50% - 2px)}
.qv-r{padding:40px 38px 34px;display:grid;gap:14px;align-content:start}
.qv-r h2{font-size:clamp(30px,3.4vw,42px)}
.qv-r .cat{font-family:var(--mono);font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--red2)}
.qv-r p{color:#b4bccd;font-size:15.5px}
