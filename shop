/* ===== cart ===== */
var cart=[],coupon='',pay='bKash';
try{cart=JSON.parse(localStorage.getItem('vy_cart')||'[]').filter(function(l){return byId(l.id)&&l.qty>0})}catch(e){cart=[]}
function save(){try{localStorage.setItem('vy_cart',JSON.stringify(cart))}catch(e){}}
function count(){return cart.reduce(function(s,l){return s+l.qty},0)}
function addCart(id,disc,qty){
  disc=disc||0;qty=qty||1;
  var l=cart.filter(function(x){return x.id===id&&x.disc===disc})[0];
  if(l)l.qty+=qty;else cart.push({id:id,qty:qty,disc:disc});
  save();renderCart();
  var b=$('#cartbtn');b.classList.remove('bump');void b.offsetWidth;b.classList.add('bump');
}
function totals(){
  var sub=0;cart.forEach(function(l){sub+=unit(byId(l.id),l.disc)*l.qty});
  var pct=SHOP.coupons[coupon]||0,d=Math.round(sub*pct/100);return{sub:sub,pct:pct,d:d,tot:sub-d};
}
function renderCart(){
  var n=count(),cb=$('#cartbtn');$('#cartn').textContent=n;cb.classList.toggle('has',n>0);
  $('#dcount').textContent=n+(n===1?' item':' items');
  var body=$('#dbody');
  if(!cart.length){body.innerHTML='<div class="cempty">'+ico('i-cart',40)+'<span>Your cart is empty.<br>Pick a tool and it will appear here.</span><button class="btn btn-ghost btn-sm" data-close-cart>Browse the catalog</button></div>';$('#dfoot').style.display='none'}
  else{
    $('#dfoot').style.display='';
    body.innerHTML=cart.map(function(l,i){var p=byId(l.id);
      return '<div class="ci" style="--a:'+p.a+';--b:'+p.b+'"><div class="th"><i class="l"></i><i class="r"></i></div><div><b>'+esc(p.name)+'</b><small>'+esc(p.cat)+(l.disc?' · <span class="tag2">bundle −'+l.disc+'%</span>':'')+'</small><div class="qty"><button data-q="-1" data-i="'+i+'" aria-label="Decrease">'+ico('i-minus',14)+'</button><span>'+l.qty+'</span><button data-q="1" data-i="'+i+'" aria-label="Increase">'+ico('i-plus',14)+'</button></div></div>'+
        '<div class="rt"><strong>'+tk(unit(p,l.disc)*l.qty)+'</strong><button class="rm" data-rm="'+i+'">Remove</button></div></div>'}).join('');
  }
  var t=totals();$('#tsub').textContent=tk(t.sub);$('#ttot').textContent=tk(t.tot);
  $('#tdrow').style.display=t.d?'':'none';$('#tdl').textContent='Coupon '+coupon+' (−'+t.pct+'%)';$('#tdisc').textContent='−'+tk(t.d);
}
function openCart(){drawer.classList.remove('sold');drawer.classList.add('open');drawer.setAttribute('aria-hidden','false');lock()}
function closeCart(){drawer.classList.remove('open');drawer.setAttribute('aria-hidden','true');setTimeout(function(){drawer.classList.remove('sold')},500);lock()}
