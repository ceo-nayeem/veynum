      var q=ctx.createOscillator();q.type='sine';q.frequency.value=r[0]*tone*det;
      var qg=ctx.createGain();
      qg.gain.setValueAtTime(.0001,t);qg.gain.exponentialRampToValueAtTime(r[1],t+.004);qg.gain.exponentialRampToValueAtTime(.0001,t+r[2]);
      q.connect(qg);qg.connect(v);q.start(t);q.stop(t+r[2]+.02)});

