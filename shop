function applyCoupon(){
  var v=$('#coupon').value.trim().toUpperCase(),n=$('#cnote');
  if(!v){coupon='';n.textContent='';renderCart();return}
  if(SHOP.coupons[v]){coupon=v;n.style.color='var(--blue2)';n.textContent='// Coupon applied: '+SHOP.coupons[v]+'% off'}
  else{coupon='';n.style.color='var(--red2)';n.textContent='// That code is not valid'}
