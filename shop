  '<div class="pbody"><span class="cat">'+esc(p.cat)+'</span><h3>'+esc(p.name)+'</h3><p>'+esc(p.tagline)+' '+esc(p.desc.split('. ')[0].replace(/\.$/,''))+'.</p>'+
