ov.addEventListener('click',function(){closeCart();closeView()});
$('#dbody').addEventListener('click',function(e){
  if(e.target.closest('[data-close-cart]')){closeCart();var c=$('#catalog');if(c)c.scrollIntoView({behavior:'smooth'});return}
  var q=e.target.closest('[data-q]'),r=e.target.closest('[data-rm]');
  if(q){var l=cart[+q.getAttribute('data-i')];l.qty+=+q.getAttribute('data-q');if(l.qty<1)cart.splice(+q.getAttribute('data-i'),1);save();renderCart()}
