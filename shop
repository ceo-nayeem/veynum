.out .mini i.r{left:calc(50% - 1px);clip-path:polygon(62% 0,100% 0,38% 100%,0 100%);background:linear-gradient(200deg,#fff,var(--b));filter:drop-shadow(0 0 8px var(--b))}
.out h3{font-size:26px}.out p{color:var(--muted);font-size:14.5px;max-width:340px}
.out .row{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-top:6px}

/* includes bento */
.bx .big2{font-family:var(--wm);font-size:clamp(34px,4.4vw,56px);line-height:1}
.chips2{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
.chips2 span{font-family:var(--mono);font-size:11.5px;padding:7px 13px;border:1px solid var(--line2);border-radius:99px;background:rgba(0,0,0,.35);color:#cfd6e6}
