function ico(n,sz){return '<svg class="i"'+(sz?' style="width:'+sz+'px;height:'+sz+'px"':'')+'><use href="#'+n+'"/></svg>'}
function artHTML(p,badge){return '<div class="art" style="--a:'+p.a+';--b:'+p.b+'">'+(badge&&p.badge?'<span class="badge">'+esc(p.badge)+'</span>':'')+(badge&&p.was?'<span class="off">−'+Math.round((1-p.price/p.was)*100)+'%</span>':'')+'<i class="l"></i><i class="r"></i><em>'+esc(p.name.toUpperCase().replace(' ',' // '))+'</em></div>'}

