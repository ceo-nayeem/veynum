function renderGrid(){
  var q=F.q.toLowerCase(),L=PRODUCTS.filter(function(p){return (F.cat==='All'||p.cat===F.cat)&&(!q||(p.name+' '+p.cat+' '+p.tagline+' '+p.desc+' '+p.tags.join(' ')).toLowerCase().indexOf(q)>-1)});
  if(F.sort==='lo')L.sort(function(a,b){return a.price-b.price});
  else if(F.sort==='hi')L.sort(function(a,b){return b.price-a.price});
  else if(F.sort==='az')L.sort(function(a,b){return a.name.localeCompare(b.name)});
