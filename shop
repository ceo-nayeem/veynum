    var items=cart.map(function(l){return l.id+':'+l.qty+(l.disc?':b'+l.disc:'')}).join(',');
    go(SHOP.checkoutUrl+(SHOP.checkoutUrl.indexOf('?')>-1?'&':'?')+'items='+encodeURIComponent(items)+(coupon?'&coupon='+coupon:'')+'&pay='+encodeURIComponent(pay));return;
