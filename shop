/* ===== command palette (Ctrl/Cmd + K) ===== */
(function(){
  var pal=$('#pal'),inp=$('#palin'),list=$('#pallist'),sel=0,vis=[],items=[
    ['Home','home','page'],['Community','community','page'],['Knowledge','knowledge','page'],['Tools','tools','page'],['Shop','shop','page'],['Membership','membership','page'],['About','about','page'],
    ['Catalog','#catalog','section'],['Bundle builder','#bundles','section'],['Find my tool','#finder','section'],['FAQ','#faq','section'],['Open cart','cart','action'],['Back to top','#top','action']];
  PRODUCTS.forEach(function(p){items.push([p.name+' · '+tk(p.price),p.id,'product'])});
  function render(){
    var q=inp.value.trim().toLowerCase();vis=items.filter(function(i){return !q||i[0].toLowerCase().indexOf(q)>-1});sel=Math.min(sel,Math.max(0,vis.length-1));
    list.innerHTML='';
    vis.forEach(function(it,k){var a=document.createElement('a');a.href='#';a.className=k===sel?'sel':'';a.innerHTML='<span>'+esc(it[0])+'</span><small>'+it[2]+'</small>';
      a.addEventListener('click',function(e){e.preventDefault();pick(it)});list.appendChild(a)});
    if(!vis.length)list.innerHTML='<a href="#" style="pointer-events:none"><span>No results</span></a>';
    var s=$('.sel',list);if(s&&s.scrollIntoView)s.scrollIntoView({block:'nearest'});
  }
  function open(){pal.classList.add('open');inp.value='';sel=0;render();setTimeout(function(){inp.focus()},30)}
  function close(){pal.classList.remove('open')}
  function pick(it){close();
    if(it[2]==='page'){it[1]===CURRENT?scrollTo({top:0,behavior:'smooth'}):go(PAGES[it[1]])}
    else if(it[2]==='product')openView(it[1]);
    else if(it[1]==='cart')openCart();
    else if(it[1]==='#top')scrollTo({top:0,behavior:'smooth'});
    else{var t=$(it[1]);if(t)t.scrollIntoView({behavior:'smooth'})}}
  $('#palbtn').addEventListener('click',open);
  pal.addEventListener('click',function(e){if(e.target===pal)close()});
  inp.addEventListener('input',function(){sel=0;render()});
  document.addEventListener('keydown',function(e){
    if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();pal.classList.contains('open')?close():open();return}
    if(!pal.classList.contains('open'))return;
    if(e.key==='Escape')close();
    else if(e.key==='ArrowDown'){e.preventDefault();sel=(sel+1)%Math.max(1,vis.length);render()}
    else if(e.key==='ArrowUp'){e.preventDefault();sel=(sel-1+vis.length)%Math.max(1,vis.length);render()}
    else if(e.key==='Enter'&&vis[sel]){e.preventDefault();pick(vis[sel])}
  });
})();
/* ===== Particles: red embers left, blue right ===== */
(function(){
  var c=$('#fx');if(!c||reduce)return;
  var x=c.getContext('2d'),W,H,dpr=Math.min(devicePixelRatio||1,2),P=[],mx=-999,my=-999;
  function mk(r){return{x:Math.random()*W,y:r?Math.random()*H:H+12,r:Math.random()*1.7+.4,vy:-(Math.random()*.4+.08),ph:Math.random()*6.28,a:Math.random()*.55+.15}}
  function size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;x.setTransform(dpr,0,0,dpr,0,0);var n=Math.min(95,Math.round(W*H/17000));P=[];for(var i=0;i<n;i++)P.push(mk(true))}
  size();addEventListener('resize',size);
  addEventListener('mousemove',function(e){mx=e.clientX;my=e.clientY},{passive:true});
  (function loop(){
    if(!document.hidden){
      x.clearRect(0,0,W,H);x.globalCompositeOperation='lighter';
      for(var i=0;i<P.length;i++){var p=P[i];p.ph+=.012;p.y+=p.vy;p.x+=Math.sin(p.ph)*.3;
        var dx=p.x-mx,dy=p.y-my,d=dx*dx+dy*dy;if(d<14400){var f=(1-d/14400)*1.4,l=Math.sqrt(d)||1;p.x+=dx/l*f;p.y+=dy/l*f}
        if(p.y<-12||p.x<-12||p.x>W+12){P[i]=mk(false);continue}
        var t=p.x/W,col=t<.5?'255,60,72':'40,190,255',al=p.a*(.35+Math.abs(t-.5)*1.3);
        x.fillStyle='rgba('+col+','+al*.22+')';x.beginPath();x.arc(p.x,p.y,p.r*4,0,6.283);x.fill();
        x.fillStyle='rgba('+col+','+al+')';x.beginPath();x.arc(p.x,p.y,p.r,0,6.283);x.fill()}
    }
    requestAnimationFrame(loop);
  })();
})();

checkHash();onScroll();
})();
</script>
<script>
/* ===== 3D product ring (Three.js): six glass-and-metal product modules orbit a VEYNUM crystal. Drag to spin, click a module to open it. ===== */
(function(){
'use strict';
if(!window.THREE)return;
var T=THREE,canvas=document.getElementById('gl'),reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;
var P=window.VY_PRODUCTS||[];if(!P.length)return;
var renderer;
try{renderer=new T.WebGLRenderer({canvas:canvas,alpha:true,antialias:true,powerPreference:'high-performance'})}catch(e){return}
renderer.setPixelRatio(Math.min(devicePixelRatio||1,1.75));renderer.setClearColor(0x000000,0);
var scene=new T.Scene(),cam=new T.PerspectiveCamera(35,1,.1,100);cam.position.set(0,0,10);
var clamp=function(v,a,b){return Math.min(b,Math.max(a,v))},lerp=function(a,b,t){return a+(b-a)*t};

scene.add(new T.AmbientLight(0x1a1f2e,1.4));
var lr=new T.PointLight(0xff2b3a,2.6,34);lr.position.set(-6,2.5,5);scene.add(lr);
var lb=new T.PointLight(0x20b8ff,2.6,34);lb.position.set(6,2.5,5);scene.add(lb);
var lt=new T.PointLight(0xffffff,.8,34);lt.position.set(0,6,7);scene.add(lt);

function glowTex(){var c=document.createElement('canvas');c.width=c.height=128;var x=c.getContext('2d'),g=x.createRadialGradient(64,64,0,64,64,64);
  g.addColorStop(0,'rgba(255,255,255,.9)');g.addColorStop(.25,'rgba(255,255,255,.35)');g.addColorStop(1,'rgba(255,255,255,0)');x.fillStyle=g;x.fillRect(0,0,128,128);return new T.CanvasTexture(c)}
var gt=glowTex();

/* central VEYNUM crystal (two shards) */
var K=250,pts=[[-427,380],[-112,255],[-17,75],[-17,-180],[-2,-380]];
function shardGeo(mirror){var s=new T.Shape();pts.forEach(function(p,i){var x=(mirror?-p[0]:p[0])/K,y=p[1]/K;i?s.lineTo(x,y):s.moveTo(x,y)});s.closePath();
  var g=new T.ExtrudeGeometry(s,{depth:.42,bevelEnabled:true,bevelThickness:.07,bevelSize:.06,bevelSegments:1});g.translate(0,0,-.21);return g}
function shard(mirror,col,emis,edge){
  var geo=shardGeo(mirror),grp=new T.Group();
  var mat=new T.MeshPhysicalMaterial({color:col,metalness:.55,roughness:.18,clearcoat:1,clearcoatRoughness:.1,emissive:emis,emissiveIntensity:1,flatShading:true});
  grp.add(new T.Mesh(geo,mat));
  grp.add(new T.LineSegments(new T.EdgesGeometry(geo,18),new T.LineBasicMaterial({color:edge,transparent:true,opacity:.95,blending:T.AdditiveBlending})));
  var sp=new T.Sprite(new T.SpriteMaterial({map:gt,color:edge,transparent:true,opacity:.55,blending:T.AdditiveBlending,depthWrite:false}));sp.scale.set(6,6,1);sp.position.set(mirror?1:-1,0,-.8);grp.add(sp);
  return grp;
}
var core=new T.Group();core.add(shard(false,0x2a0509,0x5a0010,0xff3a4a));core.add(shard(true,0x04152a,0x00305a,0x3ac4ff));core.scale.setScalar(.62);
var ring=new T.Group(),tilt=new T.Group();tilt.add(ring);tilt.add(core);tilt.rotation.x=.2;scene.add(tilt);

/* product slabs */
var R=3.35,SW=2.3,SH=1.527,slabs=[],bodies=[];
function slabTex(p){
  var c=document.createElement('canvas');c.width=512;c.height=340;var x=c.getContext('2d');
  var g=x.createLinearGradient(0,0,512,340);g.addColorStop(0,'#0c0e16');g.addColorStop(1,'#05060a');x.fillStyle=g;x.fillRect(0,0,512,340);
  var r1=x.createRadialGradient(90,120,0,90,120,260);r1.addColorStop(0,p.a+'88');r1.addColorStop(1,'transparent');x.fillStyle=r1;x.fillRect(0,0,512,340);
  var r2=x.createRadialGradient(430,120,0,430,120,260);r2.addColorStop(0,p.b+'88');r2.addColorStop(1,'transparent');x.fillStyle=r2;x.fillRect(0,0,512,340);
  x.fillStyle='rgba(255,255,255,.09)';for(var i=0;i<512;i+=16)for(var j=0;j<340;j+=16){x.fillRect(i,j,1.4,1.4)}
  /* V shards */
  function sh(ox,fl,col){x.save();x.translate(ox,40);var w=84,h=132,gg=x.createLinearGradient(0,0,w,h);gg.addColorStop(0,'#fff');gg.addColorStop(1,col);x.fillStyle=gg;x.shadowColor=col;x.shadowBlur=24;
    x.beginPath();if(!fl){x.moveTo(0,0);x.lineTo(w*.38,0);x.lineTo(w,h);x.lineTo(w*.62,h)}else{x.moveTo(w*.62,0);x.lineTo(w,0);x.lineTo(w*.38,h);x.lineTo(0,h)}x.closePath();x.fill();x.restore()}
  sh(342,false,p.a);sh(412,true,p.b);
  x.textBaseline='alphabetic';
  x.fillStyle='#8d95a9';x.font='500 17px "JetBrains Mono",monospace';x.fillText(p.cat.toUpperCase(),34,64);
  x.fillStyle='#f2f4f8';x.font='600 54px "Space Grotesk",sans-serif';x.fillText(p.name,34,246);
  x.fillStyle=p.b;x.font='600 30px "Space Grotesk","Noto Sans Bengali",sans-serif';x.fillText('৳'+p.price.toLocaleString('en-US'),34,304);
  x.fillStyle='#8d95a9';x.font='500 15px "JetBrains Mono",monospace';x.textAlign='right';x.fillText('ONE-TIME',478,304);
  x.textAlign='left';
  var bg=x.createLinearGradient(0,0,512,0);bg.addColorStop(0,p.a);bg.addColorStop(1,p.b);x.strokeStyle=bg;x.lineWidth=3;x.strokeRect(1.5,1.5,509,337);
  var t=new T.CanvasTexture(c);t.anisotropy=4;return t;
}
function buildSlab(p,i){
  var grp=new T.Group(),a=i/P.length*Math.PI*2;
  var bodyMat=new T.MeshPhysicalMaterial({color:0x0a0c12,metalness:.85,roughness:.24,clearcoat:1,clearcoatRoughness:.12,emissive:new T.Color(i%2?p.b:p.a),emissiveIntensity:.08});
  var body=new T.Mesh(new T.BoxGeometry(SW,SH,.1),bodyMat);body.userData.i=i;grp.add(body);bodies.push(body);
  var edge=new T.LineSegments(new T.EdgesGeometry(body.geometry),new T.LineBasicMaterial({color:new T.Color(i%2?p.b:p.a),transparent:true,opacity:.9,blending:T.AdditiveBlending}));grp.add(edge);
  var tex=slabTex(p);
  var front=new T.Mesh(new T.PlaneGeometry(SW-.1,SH-.07),new T.MeshBasicMaterial({map:tex,toneMapped:false}));front.position.z=.052;grp.add(front);
  var back=new T.Mesh(new T.PlaneGeometry(SW-.1,SH-.07),new T.MeshBasicMaterial({map:tex,color:0x555a66,toneMapped:false}));back.position.z=-.052;back.rotation.y=Math.PI;grp.add(back);
  var halo=new T.Sprite(new T.SpriteMaterial({map:gt,color:new T.Color(i%2?p.b:p.a),transparent:true,opacity:.35,blending:T.AdditiveBlending,depthWrite:false}));halo.scale.set(4.4,3.4,1);halo.position.z=-.3;grp.add(halo);
  grp.position.set(Math.sin(a)*R,0,Math.cos(a)*R);grp.rotation.y=a;
  ring.add(grp);slabs.push({g:grp,mat:bodyMat,halo:halo,a:a,k:0,tex:tex,p:p,front:front,back:back});
}
P.forEach(buildSlab);
if(document.fonts&&document.fonts.ready)document.fonts.ready.then(function(){slabs.forEach(function(s){var n=slabTex(s.p);s.tex.image=n.image;s.tex.needsUpdate=true})});

/* orbit rails */
function railLine(r,op,dash){var g=new T.TorusGeometry(r,.012,6,200);var m=new T.MeshBasicMaterial({color:0xffffff,transparent:true,opacity:op,blending:T.AdditiveBlending,depthWrite:false});var t=new T.Mesh(g,m);t.rotation.x=Math.PI/2;return t}
var rail1=railLine(R,.22),rail2=railLine(R+.55,.1);tilt.add(rail1);tilt.add(rail2);
var rail3=railLine(R-.55,.12);tilt.add(rail3);

/* dust */
var N=360,pos=new Float32Array(N*3),col=new Float32Array(N*3);
for(var i=0;i<N;i++){var r=2+Math.random()*4.4,a=Math.random()*6.283,b=(Math.random()-.5)*4.6;pos[i*3]=Math.cos(a)*r;pos[i*3+1]=b;pos[i*3+2]=Math.sin(a)*r;
  var red=pos[i*3]<0;col[i*3]=red?1:.15;col[i*3+1]=red?.2:.72;col[i*3+2]=red?.25:1}
var dg=new T.BufferGeometry();dg.setAttribute('position',new T.BufferAttribute(pos,3));dg.setAttribute('color',new T.BufferAttribute(col,3));
var dust=new T.Points(dg,new T.PointsMaterial({size:.05,vertexColors:true,transparent:true,opacity:.85,blending:T.AdditiveBlending,depthWrite:false}));tilt.add(dust);

var W=0,H=0;
function size(){W=innerWidth;H=innerHeight;renderer.setSize(W,H,false);cam.aspect=W/H;cam.updateProjectionMatrix()}
size();addEventListener('resize',size);

/* pointer: parallax, hover, drag-to-spin, click */
var heroVis=document.getElementById('heroVis'),hint=document.getElementById('hint3d'),vcur=document.getElementById('vcur');
var mx=0,my=0,smx=0,smy=0,ndc=new T.Vector2(),ray=new T.Raycaster(),hov=-1,spin=0,drag=false,dx0=0,lastX=0,moved=0,sy0=scrollY||0;
var hintText=hint?hint.lastChild:null,hintDefault=hintText?hintText.textContent:'';
function overVis(x,y){var b=heroVis.getBoundingClientRect();return x>=b.left-40&&x<=b.right+40&&y>=b.top-40&&y<=b.bottom+40}
function pick(x,y){ndc.set(x/W*2-1,-(y/H)*2+1);ray.setFromCamera(ndc,cam);var h=ray.intersectObjects(bodies,false);return h.length?h[0].object.userData.i:-1}
addEventListener('mousemove',function(e){
  mx=e.clientX/innerWidth-.5;my=e.clientY/innerHeight-.5;
  if(drag){var d=e.clientX-lastX;lastX=e.clientX;moved+=Math.abs(d);spin=d*.012}
  hov=(canvas.style.opacity>.3&&overVis(e.clientX,e.clientY))?pick(e.clientX,e.clientY):-1;
  if(hov>-1&&vcur)vcur.classList.add('hover');
  if(hintText)hintText.textContent=hov>-1?'Open '+P[hov].name:hintDefault;
},{passive:true});
heroVis.addEventListener('mousedown',function(e){drag=true;lastX=e.clientX;moved=0});
addEventListener('mouseup',function(){drag=false});
addEventListener('click',function(e){
  if(!heroVis.contains(e.target)||moved>6||canvas.style.opacity<.3)return;
  var i=pick(e.clientX,e.clientY);if(i>-1&&window.VY_OPEN)window.VY_OPEN(P[i].id);
});
heroVis.addEventListener('touchstart',function(e){var t=e.touches[0];lastX=t.clientX;moved=0},{passive:true});
heroVis.addEventListener('touchmove',function(e){var t=e.touches[0];moved+=Math.abs(t.clientX-lastX);spin=(t.clientX-lastX)*.012;lastX=t.clientX},{passive:true});

var worldH=function(){return 2*Math.tan(cam.fov*Math.PI/360)*cam.position.z};
var px=0,py=0,ps=1,t0=performance.now(),cur=0,rot=0,hs=[];
function frame(now){
  requestAnimationFrame(frame);
  if(document.hidden)return;
  var t=(now-t0)/1000,sy=scrollY||0,hh=innerHeight;
  var a=1-clamp((sy-hh*.25)/(hh*.65),0,1);
  if(Math.abs(a-cur)>.002){cur=a;canvas.style.opacity=a.toFixed(3)}
  if(a<.01)return;
  /* place over the hero visual */
  var b=heroVis.getBoundingClientRect(),wh=worldH(),ww=wh*cam.aspect,tx=0,ty=0,ts=.8;
  if(b.width){tx=((b.left+b.width/2)/W-.5)*ww;ty=-((b.top+b.height/2)/H-.5)*wh;ts=clamp(Math.min(b.width/W*ww*1.12/(2*(R+SW/2)),b.height/H*wh*1.5/(2*(R*.3+SH))),.2,1.3)}
  px=lerp(px,tx,.14);py=lerp(py,ty,.14);ps=lerp(ps,ts,.14);
  smx=lerp(smx,mx,.06);smy=lerp(smy,my,.06);
  /* spin: idle drift + scroll + drag momentum */
  var ds=sy-sy0;sy0=sy;
  spin*=drag?.8:.95;
  rot+=(reduce?0:.0035)+spin*.12+ds*.0016;
  ring.rotation.y=rot;
  tilt.position.set(px,py+(reduce?0:Math.sin(t*1.1)*.06),0);tilt.scale.setScalar(ps);
  tilt.rotation.x=.2-smy*.35;tilt.rotation.z=-smx*.06;tilt.rotation.y=smx*.5;
  core.rotation.y=reduce?0:t*.5;core.position.y=reduce?0:Math.sin(t*1.3)*.08;
  dust.rotation.y=t*.05;
  rail1.material.opacity=.18+.08*Math.sin(t*1.6);
  for(var i=0;i<slabs.length;i++){var s=slabs[i];
    s.k=lerp(s.k,hov===i?1:0,.14);
    s.g.scale.setScalar(1+s.k*.14);
    s.g.position.y=(reduce?0:Math.sin(t*1.2+i*1.3)*.09)+s.k*.12;
    s.mat.emissiveIntensity=.08+s.k*.6;s.halo.material.opacity=.3+s.k*.45;
  }
  lr.intensity=2.2+Math.sin(t*1.4)*.4;lb.intensity=2.2+Math.cos(t*1.4)*.4;
  renderer.render(scene,cam);
}
requestAnimationFrame(frame);
})();
</script>
