.lock{width:64px;height:64px;border-radius:18px;border:1px solid var(--line2);display:grid;place-items:center;background:#0b0c12;color:var(--blue);margin-top:10px;position:relative}
.lock::after{content:"";position:absolute;inset:-8px;border-radius:24px;border:1px solid rgba(32,184,255,.35);animation:ping3 2.4s ease-out infinite}
