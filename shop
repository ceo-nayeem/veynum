.goal svg{color:var(--red)}.goal:nth-child(even) svg{color:var(--blue)}
.goal.on{border-color:#fff;background:rgba(255,255,255,.06)}
.res{position:relative;display:grid;place-items:center;text-align:center;min-height:300px}
.res .idle{display:grid;gap:14px;place-items:center;color:var(--muted);font-family:var(--mono);font-size:12.5px}
.radar2{position:relative;width:130px;height:130px;border-radius:50%;border:1px solid var(--line2)}
.radar2::before,.radar2::after{content:"";position:absolute;inset:22px;border-radius:50%;border:1px dashed var(--line2)}
.radar2::after{inset:48px}
.radar2 i{position:absolute;inset:0;border-radius:50%;background:conic-gradient(from 0deg,transparent 70%,rgba(255,43,58,.5) 88%,rgba(32,184,255,.75) 100%);animation:spin 2.4s linear infinite;mask-image:radial-gradient(circle,#000 62%,transparent 63%);-webkit-mask-image:radial-gradient(circle,#000 62%,transparent 63%)}
.res .out{display:none;gap:12px;place-items:center;animation:pop .6s cubic-bezier(.2,.8,.2,1)}
.res.done .idle{display:none}.res.done .out{display:grid}
.res.busy .idle span{color:var(--blue2)}
.out .mini{width:84px;height:84px;position:relative;border-radius:22px;border:1px solid var(--line2);overflow:hidden;background:radial-gradient(70% 90% at 25% 60%,color-mix(in srgb,var(--a) 45%,transparent),transparent 70%),radial-gradient(70% 90% at 75% 60%,color-mix(in srgb,var(--b) 45%,transparent),transparent 70%),#07080c}
.out .mini i{position:absolute;top:15px;width:22px;height:54px}
