/* steps */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;position:relative}
.steps::before{content:"";position:absolute;left:8%;right:8%;top:62px;height:1px;background:linear-gradient(90deg,var(--red),var(--blue));opacity:.35}
.step{padding:28px}
.step .n{font-family:var(--wm);font-size:46px;line-height:1;display:block;margin-bottom:18px;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.step h3{margin-bottom:8px}.step p{color:var(--muted);font-size:14.5px}

/* faq */
.faq{display:grid;gap:10px;max-width:900px;margin-inline:auto}
.faq details{border:1px solid var(--line);border-radius:18px;background:var(--card);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);padding:0 24px;transition:border-color .3s}
.faq details[open]{border-color:var(--line2)}
.faq summary{list-style:none;padding:20px 0;display:flex;justify-content:space-between;gap:14px;align-items:center;font-family:var(--head);font-size:17px}
.faq summary::-webkit-details-marker{display:none}
.faq summary i{width:28px;height:28px;position:relative;flex:none;border:1px solid var(--line2);border-radius:50%}
.faq summary i::before,.faq summary i::after{content:"";position:absolute;left:50%;top:50%;width:10px;height:1.6px;background:#fff;transform:translate(-50%,-50%);transition:.3s}
.faq summary i::after{transform:translate(-50%,-50%) rotate(90deg)}
.faq details[open] summary i::after{transform:translate(-50%,-50%) rotate(0)}
.faq p{color:var(--muted);padding:0 0 22px;font-size:15px;max-width:740px}

/* overlay, drawer, quick view */
.ov{position:fixed;inset:0;z-index:138;background:rgba(3,3,5,.72);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);opacity:0;pointer-events:none;transition:opacity .4s}
.ov.on{opacity:1;pointer-events:auto}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(440px,100%);z-index:142;transform:translateX(105%);transition:transform .55s cubic-bezier(.2,.8,.2,1);background:#08090e;border-left:1px solid var(--line2);display:flex;flex-direction:column;box-shadow:-40px 0 120px -30px rgba(255,43,58,.35),-40px 0 120px -50px rgba(32,184,255,.4)}
.drawer.open{transform:none}
.dr-h{display:flex;justify-content:space-between;align-items:center;padding:22px 24px;border-bottom:1px solid var(--line)}
.dr-h h3{font-size:20px;display:flex;gap:10px;align-items:center}
.xbtn{width:40px;height:40px;border-radius:50%;border:1px solid var(--line2);display:grid;place-items:center;transition:.25s;flex:none}
.xbtn:hover{background:#fff;color:#07080b}
.dr-b{flex:1;overflow:auto;padding:18px 24px}
.dr-f{padding:18px 24px 24px;border-top:1px solid var(--line);display:grid;gap:12px;background:linear-gradient(transparent,rgba(255,255,255,.02))}
.ci{display:grid;grid-template-columns:56px 1fr auto;gap:14px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line);animation:pop .5s cubic-bezier(.2,.8,.2,1)}
.ci .th{width:56px;height:56px;border-radius:14px;position:relative;overflow:hidden;border:1px solid var(--line2);background:radial-gradient(70% 90% at 25% 60%,color-mix(in srgb,var(--a) 40%,transparent),transparent 70%),radial-gradient(70% 90% at 75% 60%,color-mix(in srgb,var(--b) 40%,transparent),transparent 70%),#07080c}
.ci .th i{position:absolute;top:9px;width:16px;height:38px}
.ci .th i.l{left:calc(50% - 15px);clip-path:polygon(0 0,38% 0,100% 100%,62% 100%);background:linear-gradient(160deg,#fff,var(--a))}
.ci .th i.r{left:calc(50% - 1px);clip-path:polygon(62% 0,100% 0,38% 100%,0 100%);background:linear-gradient(200deg,#fff,var(--b))}
.ci b{display:block;font-size:15px}
.ci small{display:block;margin-top:2px;color:var(--muted);font-family:var(--mono);font-size:11px}
.ci .tag2{color:var(--blue2)}
.qty{display:inline-flex;align-items:center;border:1px solid var(--line2);border-radius:99px;margin-top:8px}
.qty button{width:28px;height:28px;display:grid;place-items:center;border-radius:50%;transition:.2s}
.qty button:hover{background:#fff;color:#07080b}
.qty span{min-width:22px;text-align:center;font-family:var(--mono);font-size:12.5px}
.ci .rt{text-align:right;display:grid;gap:8px;justify-items:end}
.ci .rt strong{font-family:var(--head);font-weight:600}
.ci .rm{color:var(--muted);font-size:12px;font-family:var(--mono);transition:.2s}
.ci .rm:hover{color:var(--red2)}
.cempty{display:grid;place-items:center;gap:14px;text-align:center;color:var(--muted);padding:70px 10px;font-size:14.5px}
.coupon{display:flex;gap:8px}
.coupon input{flex:1;min-width:0;padding:11px 16px;border-radius:99px;border:1px solid var(--line2);background:rgba(0,0,0,.45);color:var(--text);font:inherit;font-size:13.5px;outline:0;text-transform:uppercase}
.coupon input:focus{border-color:#fff}
.cnote{font-family:var(--mono);font-size:11.5px;min-height:16px;color:var(--muted)}
.pays{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.pays button{padding:9px 4px;border:1px solid var(--line2);border-radius:12px;font-size:12.5px;color:var(--muted);transition:.2s;text-align:center}
.pays button.on{background:#fff;color:#07080b;border-color:#fff}
.trow{display:flex;justify-content:space-between;font-size:14px;color:var(--muted)}
.trow b{color:var(--text);font-family:var(--head);font-weight:600}
.trow.tot{font-size:16px;color:var(--text);padding-top:6px}
.trow.tot b{font-size:24px}
.done-box{display:none;place-items:center;text-align:center;gap:12px;padding:40px 10px;animation:pop .6s cubic-bezier(.2,.8,.2,1)}
.drawer.sold .done-box{display:grid}.drawer.sold .cart-live{display:none}
.okring{width:84px;height:84px;border-radius:50%;display:grid;place-items:center;border:2px solid transparent;background:linear-gradient(#08090e,#08090e) padding-box,var(--grad) border-box;box-shadow:0 0 40px -6px rgba(255,43,58,.5),0 0 40px -6px rgba(32,184,255,.5)}

.qv{position:fixed;left:50%;top:50%;width:min(1000px,94vw);max-height:90vh;overflow:auto;z-index:145;transform:translate(-50%,-46%) scale(.96);opacity:0;pointer-events:none;transition:.5s cubic-bezier(.2,.8,.2,1);border:1px solid var(--line2);border-radius:28px;background:#08090e;box-shadow:0 60px 160px -30px #000,-30px 0 120px -50px rgba(255,43,58,.55),30px 0 120px -50px rgba(32,184,255,.55)}
.qv.open{transform:translate(-50%,-50%);opacity:1;pointer-events:auto}
.qv .xbtn{position:absolute;right:18px;top:18px;z-index:6;background:rgba(5,5,7,.7)}
.qv-grid{display:grid;grid-template-columns:1fr 1.05fr}
.qv-l{position:relative;min-height:480px;border-right:1px solid var(--line)}
