.mring b{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--wm);font-weight:400;font-size:14px}
.mbars{flex:1;display:grid;gap:9px}
.mbars i{display:block;height:7px;border-radius:99px;background:linear-gradient(90deg,var(--a),var(--b));width:var(--w);animation:grow 1.3s cubic-bezier(.2,.8,.2,1) backwards;position:static;clip-path:none;filter:none}
@keyframes grow{from{width:0}}
.toast{position:fixed;left:50%;bottom:28px;z-index:160;transform:translate(-50%,30px);opacity:0;pointer-events:none;transition:.45s cubic-bezier(.2,.8,.2,1);padding:13px 22px;border:1px solid var(--line2);border-radius:99px;background:rgba(8,9,13,.92);backdrop-filter:blur(10px);font-size:14px;display:flex;gap:10px;align-items:center;box-shadow:-14px 0 40px -14px rgba(255,43,58,.5),14px 0 40px -14px rgba(32,184,255,.5)}
