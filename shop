/* ===== bundle builder ===== */
var sel={};
(function(){
  var box=$('#btog');
  box.innerHTML=PRODUCTS.map(function(p){return '<button class="bt" data-b="'+p.id+'" aria-pressed="false"><i></i><span><b>'+esc(p.name)+'</b><small>'+esc(p.cat)+'</small></span><span class="pr">'+tk(p.price)+'</span></button>'}).join('');
  function num(el,to){var from=el._v||0;el._v=to;var t0=performance.now();
    if(reduce){el.textContent=el._f(to);return}
    (function s(t){var k=clamp((t-t0)/500,0,1);k=1-Math.pow(1-k,3);el.textContent=el._f(from+(to-from)*k);if(k<1)requestAnimationFrame(s)})(t0)}
  var eS=$('#bsub'),eD=$('#bdis'),eP=$('#bpay');eS._f=tk;eD._f=function(v){return '−'+tk(v)};eP._f=tk;
  function upd(){
    var ids=Object.keys(sel).filter(function(k){return sel[k]}),n=ids.length,sub=0;
    ids.forEach(function(k){sub+=byId(k).price});
    var pct=n>=2?5*n:0,d=Math.round(sub*pct/100);
    $$('.bt',box).forEach(function(b){var on=!!sel[b.getAttribute('data-b')];b.classList.toggle('on',on);b.setAttribute('aria-pressed',on)});
    $$('#ladder span').forEach(function(s,i){s.classList.toggle('on',n>=i+2)});
    $('#bcount').textContent=n+' selected';$('#bdl').textContent='Bundle discount'+(pct?' ('+pct+'%)':'');
    num(eS,sub);num(eD,d);num(eP,sub-d);
    $('#bnote').textContent=n<2?'Select at least two tools to unlock savings.':'You save '+tk(d)+' with '+n+' tools.';
    $('#badd').disabled=n<2;$('#badd')._pct=pct;
  }
  box.addEventListener('click',function(e){var b=e.target.closest('[data-b]');if(!b)return;var k=b.getAttribute('data-b');sel[k]=!sel[k];upd()});
  $('#ball').addEventListener('click',function(){PRODUCTS.forEach(function(p){sel[p.id]=true});upd()});
  $('#bnone').addEventListener('click',function(){sel={};upd()});
  $('#badd').addEventListener('click',function(){
    var pct=this._pct,ids=Object.keys(sel).filter(function(k){return sel[k]});if(ids.length<2)return;
    ids.forEach(function(k){addCart(k,pct)});toast('Bundle of '+ids.length+' added · −'+pct+'%');setTimeout(openCart,260);
    var b=this.getBoundingClientRect();confetti(b.left+b.width/2,b.top)
  });
  sel={'habit-os':true,'deep-focus':true,'life-journal':true};upd();
})();

