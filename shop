.mock{position:absolute;left:8%;right:8%;bottom:8%;z-index:3;border:1px solid var(--line2);border-radius:16px;background:rgba(6,7,11,.88);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);padding:14px 16px 18px;box-shadow:0 30px 60px -20px #000}
