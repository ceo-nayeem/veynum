.sp .pfoot{margin-top:12px}
.pact{display:grid;grid-template-columns:1fr 1.3fr;gap:10px;padding:0 22px 22px;position:relative;z-index:3}
.pact .btn{justify-content:center;padding-inline:14px}

/* section heading helpers */
.lead2{color:var(--muted);max-width:520px;margin-top:12px}

/* bundle builder */
.bld{display:grid;grid-template-columns:1.25fr .75fr;gap:18px}
.btoggles{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.bt{display:flex;gap:12px;align-items:center;text-align:left;padding:14px 16px;border:1px solid var(--line);border-radius:16px;background:rgba(0,0,0,.3);transition:.25s;width:100%}
.bt:hover{border-color:var(--line2);transform:translateY(-2px)}
.bt i{width:22px;height:22px;border-radius:7px;border:1.5px solid #3a4154;display:grid;place-items:center;flex:none;transition:.25s}
.bt i::after{content:"";width:10px;height:5px;border-left:2px solid #07080b;border-bottom:2px solid #07080b;transform:rotate(-45deg) scale(0);margin-top:-2px;transition:.25s}
.bt b{display:block;font-size:14.5px;font-weight:600}
.bt small{color:var(--muted);font-family:var(--mono);font-size:11px}
.bt .pr{margin-left:auto;font-family:var(--head);font-weight:600;font-size:15px}
.bt.on{border:1px solid transparent;background:linear-gradient(#0b0c12,#0b0c12) padding-box,var(--grad) border-box}
.bt.on i{background:linear-gradient(135deg,var(--red),var(--blue));border-color:transparent}
.bt.on i::after{transform:rotate(-45deg) scale(1)}
.ladder{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin:6px 0 22px}
.ladder span{font-family:var(--mono);font-size:10.5px;text-align:center;color:#4e566b;display:grid;gap:6px;transition:.4s}
.ladder span::before{content:"";height:5px;border-radius:5px;background:#171a24;transition:.5s}
.ladder span.on{color:var(--text)}
.ladder span.on::before{background:var(--grad);box-shadow:0 0 10px rgba(255,43,58,.4)}
.sumrow{display:flex;justify-content:space-between;color:var(--muted);font-size:14px;padding:9px 0;border-bottom:1px solid var(--line)}
.sumrow b{color:var(--text);font-family:var(--head);font-weight:600}
.sumrow.save b{color:var(--blue2)}
.paybig{font-family:var(--wm);font-size:clamp(30px,3.2vw,42px);line-height:1.1;margin:18px 0 4px;letter-spacing:.01em}
.paynote{font-family:var(--mono);font-size:11.5px;color:var(--muted);margin-bottom:18px;min-height:18px}

/* finder */
.find{display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:stretch}
.goals{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.goal{padding:15px 16px;border:1px solid var(--line);border-radius:14px;text-align:left;background:rgba(0,0,0,.3);display:flex;gap:12px;align-items:center;transition:.25s;font-size:14.5px}
